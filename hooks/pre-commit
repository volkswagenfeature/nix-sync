#! /bin/bash
######## CONFIGURABLES ########
mapfile PROHIBITEDNAMES < <(echo -e ".*secrets.nix")
HEADER_WIDTH=30

# Colors
RED="\033[1;31m"
YELLOW="\033[38;5;214m"
GREEN="\033[1;32m"

HEDCOL="\033[0;36m"
RST="\033[0m"

## System messages ##
# The message used in a auto-generated commit.
COMMITMSG="Pre-commit updated lockfile on $(date -Iseconds)" 

## Paths ##
# The relative path to the lockfile within the git directory
LOCKFILE="nixos/flake.lock"

######## SETUP ##########

GITPATH=$( git rev-parse --show-toplevel )

# Get path to secrets, and do detection/error handling for that.
mapfile SECRETPATH < <( find $GITPATH -name secrets.nix )
if [[ "${#SECRETPATH[@]}" -ne 1 ]] then
    echo "Error. More than one filepath with name 'secrets.nix' found."
    for p in ${SECRETPATH[@]}; do echo ">" $p; done 
    exit 1
fi

# Get all paths staged for commit.
mapfile STAGED < <(\
    git diff --name-only --cached |
    xargs -I{} echo -n "$GITPATH/{} "
)

# If run as 'pre-commit all', add everything except the prohibited files.
if [[ $1 == "all" ]]; then
    declare -a TOCHECK
    for TF in $(git ls-files $GITPATH); do
        for PF in ${PROHIBITEDNAMES[@]}; do
            if [[ "$TF" =~ $PF ]]; then
                SKIP=1
            fi
        done
        if [[ -n $SKIP ]]; then
            unset SKIP
        else
            TOCHECK+=($TF)
        fi
    done
else
    # Otherwise, just check staged files
    TOCHECK=("${STAGED[@]}") 
fi


# Load and format variables from nixfile
mapfile NIXVARS < <( echo -e $( nix eval --impure --expr "
    let l = (import <nixpkgs> {}).lib;
    in l.strings.concatMapStringsSep \"\\n\" toString (
        l.lists.flatten( 
            l.collect ( a: !builtins.isAttrs a) (import $SECRETPATH {})
        )
    )
" ) | tr -d '"' )
#echo "${NIXVARS[@]}"

prompt_confirm() {
  for ((count=0; count<20 ; count++)); do
    read -r -N 1 -p "$1 [y/n]: " REPLY < /dev/tty

    case $REPLY in
      [yY]) echo ; return 0 ;;
      [nN]) echo ; return 1 ;;
      *) printf '\033[31m '\''%s'\'' %s \n${RST}' "$REPLY" "invalid input"
    esac 
  done  
  if [[ ! "$input" =~ ^[YyNn]$  ]]; then
	echo "FAILED TO GATHER INPUT."
    exit 1
  fi
}

centered_header() {
    local title="$1"
    local width="$HEADER_WIDTH"
    local title_length=${#title}

    # Calculate the total padding needed (in equal signs)
    local padding=$(( (width - title_length - 4) / 2 ))

    # Ensure padding is not negative
    if (( padding < 0 )); then
        padding=0
    fi

	if (( title_length % 2 )); then
		r_padding=$(( padding+1 ))
    else
		r_padding=$padding
    fi
	


    # Generate the padded header using equal signs for padding
    local l_pad="$(printf '=%.0s' $(seq 1 $padding))"
	local r_pad="$(printf '=%.0s' $(seq 1 $r_padding))"
	local head_template="${HEDCOL}%s${RST} %s ${HEDCOL}%s${RST}\n" 
    printf "$head_template" "$l_pad" "$title" "$r_pad"
}


##### CHECKING #####
EXIT=0

# Debug printopts
#echo "Script is: $0 running using $$ PID"
#echo "Current shell used within the script is: `readlink /proc/$$/exe`"
#echo -e "\033$RED RED"
#echo -e "\033$YELLOW YELLOW"
#echo -e "\033$GREEN GREEN ${RST}"
#script_shell="$(readlink /proc/$$/exe | sed "s/.*\///")"
#echo -e "\nSHELL is = ${script_shell}\n"

#printf $SECTION_HEADER "FORBIDDEN FILE CHECK"
centered_header "FORBIDDEN FILE CHECK"
for PF in ${PROHIBITEDNAMES[@]}; do
    for SF in ${TOCHECK[@]}; do
        if [[ "$SF" =~ $PF ]]; then
            echo -e "File path '$SF' matched regex ${RED}$PF${RST}"
            FAIL=1

        else
            #echo " $SF != $PF"
            true
        fi
        done
done
if [[ -n $FAIL ]]; then
    EXIT=1
    unset FAIL
else
    echo -e "${GREEN}PASS\033[1;0m"
fi


centered_header "SECRET STRING CHECK"
for FILE in ${TOCHECK[@]}; do
    for VAR in ${NIXVARS[@]}; do
        if [[ $(grep -c "$VAR" "$FILE") -ne 0 ]]; then
            echo -e "\nFound prohibited string ${RED}$VAR${RST} in $FILE"
            echo "grep results: "
            echo -e "${HEDCOL}======${RST}"

            grep -n -C 3 --group-separator='======' --color=always \
            "$VAR" "$FILE"
            echo -e "${HEDCOL}======${RST}"
            FAIL=1
        fi
    done
done
if [[ -n $FAIL ]]; then
    EXIT=1
    unset FAIL
else
    echo -e "${GREEN}PASS\033[1;0m"
fi


centered_header "FLAKE ON LATEST"
flakepath="$(mktemp "flake.lock.XXXXXX" -p "/tmp" )"
fctmp="nix flake update
        --output-lock-file $flakepath
        --flake $GITPATH/nixos
        --option warn-dirty false
        --option allow-dirty true
        "

flakecheck=$(echo $fctmp)

# Doesn't seem to quite work yet...
CopyLock () {
        if [[ $EXIT -eq 0 ]]; then
                echo "sudo cp:"
                sudo cp $flakepath $GITPATH/$LOCKFILE < /dev/tty
                git commit -m "${COMMITMSG}" --no-verify -- "$GITPATH/$LOCKFILE"
                echo -e "${RED}AUTOGENERATED A Commit!${RST}"
                echo -e "Git hooks do no support changing HEAD in-flight. Please re-run."
        else
                echo -e "${YELLOW}Refusing to make changes due to prior failures${RST}"
        fi
}

# Don't run if there's no internet.
if ping -c 1 8.8.8.8 > /dev/null 2>&1; then
        #If lockfile exists and is empty, just delete it.
        #A workaround for the parsing error $flakecheck throws when
        #it hits a empty file.
        if [[ -e "$GITPATH/$LOCKFILE" && ! -s "$GITPATH/$LOCKFILE" ]]; then
                echo -e "Deleting empty flake file"
                sudo rm "$GITPATH/$LOCKFILE"
        fi


	echo -e "Running \n${HEDCOL}$flakecheck${RST}\nCommand output follows:"
	echo -e "\n${HEDCOL}======${RST}"
	results=$(eval $flakecheck ) 
        ret=$?
	echo -e "${HEDCOL}======${RST}"
	if [[ $ret -eq 0 ]]; then
                if [[ -s "$GITPATH/$LOCKFILE" ]]; then
                        jcompare="jd $flakepath \"$GITPATH/$LOCKFILE\" > /dev/null "
                        #echo "$jcompare"
                        eval "$jcompare"

                        if [[ $? -eq 0 ]]; then
                                echo -e "${GREEN}PASS\033[1;0m"
                        else
                                echo -e "\n${RED}Lockfile out of date${RST}\n"
                                echo -e "Generated lockfile at $flakepath with $(wc -l < $flakepath) lines"
                                if prompt_confirm "Update local lockfile?"; then
                                        CopyLock
                                        FAIL=1
                                else
                                        if prompt_confirm "Commit out of date lockfile?"; then
                                                echo -e "${YELLOW}TEST BYPASSED${RST}"
                                        else
                                                echo -e "${RED}FAIL${RST}"
                                                FAIL=1
                                        fi
                                fi
                        fi
                else
                        echo -e "${YELLOW}Lockfile empty or missing, Copying new lockfile.${RST}"
                        CopyLock
                fi


	else
		echo -e "${RED}FAIL${RST} Encountered error running flake"
		FAIL=1
	fi
else
  echo -e "${YELLOW}TEST BYPASSED:${RST} NO INTERNET"
fi


if [[ -n $FAIL ]]; then
    EXIT=1
    unset FAIL
fi



# TODO: Add a check for the latest firmware either here or in the build setup?

echo ""

if [[ $EXIT -eq 0 ]]; then
        echo -e "${HEDCOL}==${GREEN}  All Tests Passed  ${HEDCOL}==${RST}"
else
        echo -e "${HEDCOL}==${RED}  Commit Aborted ${HEDCOL}==${RST}"
fi

exit $EXIT
